APP_NAME="Pero Jewelry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=perojewelry
DB_USERNAME=perojewelry_user
DB_PASSWORD=secretpassword
# TiDB Cloud example (preferred for free remote DB):
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_DATABASE=pero
# DB_USERNAME=xxxxxxxx.root
# DB_PASSWORD=
# DB_URL="mysql://USER:PASSWORD@HOST:4000/pero"
# DB_SSL=true
# MYSQL_ATTR_SSL_CA=certs/isrgrootx1.pem

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Comma-separated hosts (no protocol) for Sanctum cookie auth
SANCTUM_STATEFUL_DOMAINS=localhost:4200,localhost:8000,127.0.0.1:4200,127.0.0.1:8000,[::1]:4200,[::1]:8000

# Comma-separated full origins for CORS (local Angular + optional production URL)
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://[::1]:4200
FRONTEND_URL=http://localhost:4200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@perojewelry.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
