APP_NAME="Pero Jewelry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-SERVICE.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# TiDB Cloud / MySQL (create the database in the console first, e.g. `pero`)
DB_CONNECTION=mysql
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=pero
DB_USERNAME=
DB_PASSWORD=
# Optional single URL (Laravel reads DB_URL, not DATABASE_URL)
# DB_URL="mysql://USER:PASSWORD@HOST:4000/pero"
DB_SSL=true
# Bundled Let's Encrypt ISRG Root X1 (copied into the production image)
MYSQL_ATTR_SSL_CA=/var/www/html/certs/isrgrootx1.pem

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

# Host only (no https://), e.g. your-service.onrender.com
SANCTUM_STATEFUL_DOMAINS=YOUR-SERVICE.onrender.com

# Full origins (with https://). Same-origin deploy still benefits from APP_URL.
CORS_ALLOWED_ORIGINS=https://YOUR-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-SERVICE.onrender.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@perojewelry.com"
MAIL_FROM_NAME="${APP_NAME}"

# Set to true on first deploy (or once) to load demo products/admin.
# Change the default admin password immediately after seeding.
# Admin: admin@perojewelry.com / password
RUN_SEEDERS=false
